# PostgreSQL connection string (required)
#
# Local dev (Homebrew PostgreSQL 16):
#   brew services start postgresql@16
#   psql -d postgres -c "CREATE DATABASE atlas_queue;"
#   psql -d postgres -c "CREATE USER atlas WITH PASSWORD 'YOUR_PASSWORD' LOGIN;"
#   psql -d postgres -c "GRANT ALL PRIVILEGES ON DATABASE atlas_queue TO atlas;"
#   psql -d atlas_queue -c "GRANT ALL ON SCHEMA public TO atlas;"
#
# Verify (replace USER and PASSWORD with your values):
#   psql "postgresql://USER:PASSWORD@localhost:5432/atlas_queue" -c '\conninfo'
#
# Optional override for live Postgres-backed tests. Default dev container:
#   ./scripts/dev-test-postgres.sh up
# LIVE_MIGRATIONS_TEST_DATABASE_URL=postgresql+asyncpg://atlas:atlas@localhost:5434/atlas_queue_test
#
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/atlas_queue

# Integer seconds a claimed job is held before the lease expires (default: 30)
LEASE_TTL_SECONDS=30

# Float seconds between lease-extension heartbeats for in-flight jobs (default: 10.0).
# Must be less than LEASE_TTL_SECONDS.
LEASE_HEARTBEAT_INTERVAL_SECONDS=10.0

# Seconds between worker poll cycles (default: 1.0)
POLL_INTERVAL_SECONDS=1.0

# Empty-queue poll backoff: interval *= multiplier up to max (defaults: 2.0, 30.0).
# Keep POLL_BACKOFF_MAX_SECONDS >= POLL_INTERVAL_SECONDS; if max is lower, empty polls
# sleep for max instead of the base interval.
POLL_BACKOFF_MULTIPLIER=2.0
POLL_BACKOFF_MAX_SECONDS=30.0

# Job retry backoff: base * multiplier^(attempt-1), capped at max (defaults: 10.0, 3.0, 300.0).
# RETRY_BACKOFF_MAX_SECONDS must be >= RETRY_BACKOFF_BASE_SECONDS.
RETRY_BACKOFF_BASE_SECONDS=10.0
RETRY_BACKOFF_MULTIPLIER=3.0
RETRY_BACKOFF_MAX_SECONDS=300.0

# Optional jitter on retry delay to spread retries (default: 0.0 = disabled).
# Fraction in [0.0, 1.0]; delay is multiplied by 1 +/- this ratio before re-clamping to max.
# At 1.0, delay can swing down to zero.
RETRY_BACKOFF_JITTER_RATIO=0.0

# Parallel claim slots per worker process (default: 4)
WORKER_CONCURRENCY=4

# Logging (default: INFO, json)
LOG_LEVEL=INFO
LOG_FORMAT=json
